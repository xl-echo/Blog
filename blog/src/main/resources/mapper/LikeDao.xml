<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.echo.blog.dao.LikeDao">
  <resultMap id="BaseResultMap" type="com.echo.blog.po.LikePo">
    <id column="id" jdbcType="BIGINT" property="id" />
    <result column="article_id" jdbcType="BIGINT" property="articleId" />
    <result column="user_id" jdbcType="BIGINT" property="userId" />
    <result column="username" jdbcType="VARCHAR" property="username" />
    <result column="create_time" jdbcType="TIMESTAMP" property="createTime" />
  </resultMap>

  <insert id="insert" parameterType="com.echo.blog.po.LikePo" useGeneratedKeys="true" keyProperty="id">
    insert into `like` (article_id, user_id, username, create_time)
    values (#{articleId}, #{userId}, #{username}, #{createTime})
  </insert>

  <select id="selectByArticleIdAndUserId" resultMap="BaseResultMap">
    select id, article_id, user_id, username, create_time
    from `like`
    where article_id = #{articleId} and user_id = #{userId}
  </select>

  <delete id="deleteByArticleIdAndUserId">
    delete from `like`
    where article_id = #{articleId} and user_id = #{userId}
  </delete>

  <select id="countByArticleId" parameterType="java.lang.Long" resultType="java.lang.Integer">
    select count(*) from `like` where article_id = #{articleId}
  </select>
</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.echo.blog.dao.CommentDao">
  <resultMap id="BaseResultMap" type="com.echo.blog.po.CommentPo">
    <id column="id" jdbcType="BIGINT" property="id" />
    <result column="article_id" jdbcType="BIGINT" property="articleId" />
    <result column="user_id" jdbcType="BIGINT" property="userId" />
    <result column="username" jdbcType="VARCHAR" property="username" />
    <result column="content" jdbcType="VARCHAR" property="content" />
    <result column="create_time" jdbcType="TIMESTAMP" property="createTime" />
    <result column="update_time" jdbcType="TIMESTAMP" property="updateTime" />
  </resultMap>

  <insert id="insert" parameterType="com.echo.blog.po.CommentPo" useGeneratedKeys="true" keyProperty="id">
    insert into comment (article_id, user_id, username, content, create_time, update_time)
    values (#{articleId}, #{userId}, #{username}, #{content}, #{createTime}, #{updateTime})
  </insert>

  <select id="selectByArticleId" parameterType="java.lang.Long" resultMap="BaseResultMap">
    select id, article_id, user_id, username, content, create_time, update_time
    from comment
    where article_id = #{articleId}
    order by create_time desc
  </select>

  <delete id="deleteById" parameterType="java.lang.Long">
    delete from comment where id = #{id}
  </delete>
</mapper>
